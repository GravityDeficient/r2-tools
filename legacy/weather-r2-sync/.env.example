# Cloudflare R2 credentials
# Get these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_BUCKET=weather-forecasts
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Path to weather archive (default: /mnt/muninn/weather-archive)
# On raspi: /mnt/muninn/weather-archive
# On huginn: /mnt/muninn/weather-archive (or /opt/weather if syncing from local)
WEATHER_ARCHIVE_DIR=/mnt/muninn/weather-archive
